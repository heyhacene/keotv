<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_item_selector"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/tv_episode_num"
        android:layout_width="38dp"
        android:layout_height="wrap_content"
        android:text="E1"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_episode_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Titre de l'épisode"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_episode_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Résumé de l'épisode..."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_episode_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="45m"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▶"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
