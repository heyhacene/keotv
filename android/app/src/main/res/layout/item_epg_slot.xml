<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_epg_slot"
    android:layout_width="160dp"
    android:layout_height="38dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_epg_slot_selector"
    android:focusable="true"
    android:clickable="true">

    <!-- Top line: Time interval + Status badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_slot_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#94A3B8"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_slot_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#38BDF8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Program Title -->
    <TextView
        android:id="@+id/tv_slot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F8FAFC"
        android:textSize="11sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <!-- Mini Progress Bar (only visible for current program) -->
    <ProgressBar
        android:id="@+id/pb_slot_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_marginTop="1dp"
        android:max="100"
        android:progress="50"
        android:progressTint="#38BDF8"
        android:progressBackgroundTint="#1E293B"
        android:visibility="gone" />

</LinearLayout>
