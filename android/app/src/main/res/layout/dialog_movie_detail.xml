<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="640dp"
    android:maxWidth="820dp"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="24dp">

    <!-- Header: Title, Year, Duration, Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_movie_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Titre du Film"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_movie_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ 8.5"
            android:textColor="#F59E0B"
            android:textSize="13sp"
            android:textStyle="bold"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="#26F59E0B"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_movie_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_movie_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • 1h 54m"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_movie_genre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • Action / Drame"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Main Content: Poster on left, Synopsis & Cast on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Movie Poster -->
        <ImageView
            android:id="@+id/iv_movie_poster"
            android:layout_width="160dp"
            android:layout_height="230dp"
            android:scaleType="centerCrop"
            android:background="#1E293B"
            android:layout_marginEnd="20dp" />

        <!-- Details Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RÉSUMÉ"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                android:scrollbars="vertical">

                <TextView
                    android:id="@+id/tv_movie_plot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CBD5E1"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:text="Chargement des informations du film..." />

            </ScrollView>

            <TextView
                android:id="@+id/tv_movie_director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:text="Réalisateur : -"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_movie_cast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:text="Acteurs : -"
                android:maxLines="2"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btn_search_actor"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="8dp"
                android:text="🔍 Rechercher les films de ces acteurs"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btn_fav_movie"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="⭐ Favori"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginEnd="12dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_play_movie"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="▶ Regarder le Film"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginEnd="12dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_close_movie"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Fermer"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
