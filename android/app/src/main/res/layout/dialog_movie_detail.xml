<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp">

    <!-- Top: Poster on left, Title & Badges on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/iv_movie_poster"
            android:layout_width="105dp"
            android:layout_height="155dp"
            android:scaleType="fitCenter"
            android:background="#0B1120"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_movie_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Titre du Film"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_movie_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐ 8.5"
                    android:textColor="#F59E0B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="#2BF59E0B"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tv_movie_year"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_movie_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • 1h 54m"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_movie_genre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Action / Drame"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <Button
                android:id="@+id/btn_movie_director"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_selector"
                android:textColor="#38BDF8"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:text="🎬 Réalisateur : -"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_movie_director"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:text="Réalisateur : -"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- Main Content: Full-width Plot & Actor Chips -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RÉSUMÉ"
        android:textColor="#64748B"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginTop="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:focusable="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_movie_plot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp"
            android:lineSpacingExtra="3dp"
            android:text="Chargement des informations du film..." />

    </ScrollView>

    <!-- Individual Director & Actor Chips Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="RÉALISATEUR &amp; ACTEURS (cliquez pour voir tous leurs films) :"
        android:textColor="#38BDF8"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <!-- Horizontal Scrollable Actor Chips -->
    <HorizontalScrollView
        android:id="@+id/hsv_movie_actors"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layout_actors_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_movie_cast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64748B"
                android:textSize="11sp"
                android:text="Chargement des acteurs..." />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Fallback Search Button -->
    <Button
        android:id="@+id/btn_search_actor"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:text="🔍 Rechercher ce film ou premier acteur"
        android:textColor="#94A3B8"
        android:textSize="10.5sp"
        android:background="@drawable/bg_button_selector"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        android:focusable="true" />

    <!-- Bottom Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btn_restart_movie"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="↺ Recommencer"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_play_movie"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="▶ Regarder le Film"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:layout_marginEnd="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_fav_movie"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="⭐ Favori"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="8dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_close_movie"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="✕ Fermer"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="true" />

    </LinearLayout>

</LinearLayout>
