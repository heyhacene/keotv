<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080C14">

    <!-- Top Compact Header (Mobile Portrait) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="#0F172A">

        <!-- Row 1: Logo & Badges -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KeoTV"
                android:textColor="#38BDF8"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="✅ Prêt"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#132E27" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_header_update"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔄 MàJ"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:focusable="true" />

        </LinearLayout>

        <!-- Row 2: Sync Info -->
        <TextView
            android:id="@+id/tv_header_sync_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:text="Abonnement Xtream"
            android:singleLine="true" />

        <!-- Row 3: Horizontal Action Buttons -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_header_cloud"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="☁️ Rapatrier"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_selector"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_header_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="🔄 Synchroniser"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_selector"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_header_diagnostic"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⚙️ Paramètres"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_selector"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_header_login"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="👤 Compte"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_selector"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Row 4: Content Type Switcher (TV / Replay / Films / Séries / Favoris) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/tab_live"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="📺 TV"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_selector"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/tab_replay"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1.1"
                android:text="🔄 Replay"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_selector"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/tab_vod"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="🎬 Films"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_selector"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/tab_series"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="🍿 Séries"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_selector"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/tab_favs"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="⭐ Favoris"
                android:textColor="#F59E0B"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_selector"
                android:layout_marginEnd="3dp" />

            <Button
                android:id="@+id/tab_search"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:text="🔍 Chercher"
                android:textColor="#38BDF8"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tab_selector" />

        </LinearLayout>

        <!-- Row 5: Search input -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:hint="🔍 Rechercher une chaîne ou bouquet..."
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="12sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_item_selector"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Split / Channels Content -->
        <LinearLayout
            android:id="@+id/layout_content_split"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Bouquets TV Horizontal Chips -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_bouquets_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BOUQUETS TV"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_categories"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:nextFocusUp="@+id/recycler_categories"
                    android:nextFocusDown="@+id/recycler_channels"
                    android:scrollbars="none"
                    android:overScrollMode="always"
                    android:nestedScrollingEnabled="true" />

            </LinearLayout>

            <!-- Channels List (Full remaining height in portrait) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp">

                <TextView
                    android:id="@+id/tv_channels_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHAÎNES DU BOUQUET"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_channels"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:nextFocusLeft="@+id/recycler_categories"
                    android:nextFocusRight="@+id/recycler_channels"
                    android:nextFocusUp="@+id/recycler_channels"
                    android:nextFocusDown="@+id/recycler_channels"
                    android:scrollbars="vertical"
                    android:overScrollMode="always"
                    android:nestedScrollingEnabled="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Search Panel (Visible when currentType == "search") -->
        <LinearLayout
            android:id="@+id/panel_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <!-- Search Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/et_global_search"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="🔍 Rechercher chaînes, films, séries, acteurs..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:background="@drawable/bg_item_selector"
                    android:singleLine="true"
                    android:inputType="text|textNoSuggestions"
                    android:imeOptions="actionSearch" />

                <Button
                    android:id="@+id/btn_search_backspace"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="⌫"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"
                    android:background="@drawable/bg_button_selector"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <Button
                    android:id="@+id/btn_search_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:text="✖"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_selector"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

            </LinearLayout>

            <!-- Search Type Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_search_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Tout"
                        android:textColor="#FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_search_filter_live"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="📺 Direct TV"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_search_filter_vod"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🎬 Films VOD"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btn_search_filter_series"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🍿 Séries TV"
                        android:textColor="#94A3B8"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector" />

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_search_results_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Saisissez un texte pour rechercher dans tous les catalogues."
                android:textColor="#64748B"
                android:textSize="11.5sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_search_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="6dp"
                android:scrollbars="vertical" />

        </LinearLayout>

    </FrameLayout>

    <!-- Active Channel Bottom Bar (Mobile Portrait) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_card"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_detail_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sélectionnez une chaîne"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_detail_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:text="Direct TV" />

                <TextView
                    android:id="@+id/tv_detail_resolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:text="HD" />

                <TextView
                    android:id="@+id/tv_detail_epg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <!-- Star favorite icon button -->
        <Button
            android:id="@+id/btn_toggle_fav"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="⭐"
            android:textSize="14sp"
            android:background="@drawable/bg_button_selector"
            android:layout_marginEnd="6dp" />

        <!-- Replay button -->
        <Button
            android:id="@+id/btn_replay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="🔄"
            android:textSize="14sp"
            android:background="@drawable/bg_button_selector"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <!-- Watch fullscreen button -->
        <Button
            android:id="@+id/btn_watch_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="▶ Regarder"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

    </LinearLayout>

</LinearLayout>
