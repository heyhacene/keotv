<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_item_selector"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/tv_channel_num"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:textColor="#64748B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <ImageView
        android:id="@+id/iv_channel_logo"
        android:layout_width="36dp"
        android:layout_height="26dp"
        android:scaleType="fitCenter"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Channel Title & Badges Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_channel_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_channel_fav_star"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="11sp"
                android:layout_marginStart="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_channel_replay_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔄 Replay"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="#1538BDF8"
                android:layout_marginStart="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_channel_res"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#0F243A"
                android:layout_marginStart="6dp" />

        </LinearLayout>

        <!-- Fallback / Subtitle line for VOD / Series / simple view -->
        <TextView
            android:id="@+id/tv_channel_epg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Direct TV" />

        <!-- TiviMate EPG Timeline Row (Continuous Horizontal Ribbon) -->
        <HorizontalScrollView
            android:id="@+id/layout_epg_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:fillViewport="false"
            android:layout_marginTop="4dp"
            android:focusable="false"
            android:clickable="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layout_epg_slots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:focusable="false"
                android:clickable="false" />

        </HorizontalScrollView>

    </LinearLayout>

</LinearLayout>
