<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme with Dark mode by default for TV & mobile -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="alertDialogTheme">@style/DarkAlertDialogTheme</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#0B111E</item>
        <item name="android:textColor">#F8FAFC</item>
        <item name="alertDialogTheme">@style/DarkAlertDialogTheme</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">#0B111E</item>
    </style>

    <style name="DarkAlertDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:background">#131B2A</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>
        <item name="colorAccent">#38BDF8</item>
    </style>
</resources>
