<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#080C14">

    <!-- 1. LEFT SIDEBAR (v1.3 Navigation Layout) -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="92dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#0A0F1D"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Logo / Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KeoTV"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Navigation Buttons -->
                <Button
                    android:id="@+id/btn_nav_live"
                    android:layout_width="84dp"
                    android:layout_height="50dp"
                    android:text="📺\nDIRECT"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_nav_replay"
                    android:layout_width="84dp"
                    android:layout_height="50dp"
                    android:text="🔄\nREPLAY"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_nav_vod"
                    android:layout_width="84dp"
                    android:layout_height="50dp"
                    android:text="🎬\nFILMS"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_nav_series"
                    android:layout_width="84dp"
                    android:layout_height="50dp"
                    android:text="🍿\nSÉRIES"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_nav_favs"
                    android:layout_width="84dp"
                    android:layout_height="50dp"
                    android:text="⭐\nFAVORIS"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_nav_search"
                    android:layout_width="84dp"
                    android:layout_height="50dp"
                    android:text="🔍\nCHERCHER"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <!-- Utility Buttons -->
                <Button
                    android:id="@+id/btn_nav_settings"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:text="⚙️\nOPTIONS"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:layout_marginBottom="5dp"
                    android:focusable="true" />

                <Button
                    android:id="@+id/btn_nav_sync"
                    android:layout_width="84dp"
                    android:layout_height="44dp"
                    android:text="☁️\nSYNCHRO"
                    android:textColor="#34D399"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="1dp"
                    android:background="@drawable/bg_nav_item_selector"
                    android:focusable="true" />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <!-- 2. MAIN CONTENT AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#0F172A">

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 DIRECT TV"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="✅ Prêt"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#132E27" />

            <TextView
                android:id="@+id/tv_header_sync_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:text="Abonnement Xtream"
                android:singleLine="true" />

            <!-- Hidden compatibility buttons for programmatic triggers / portrait -->
            <Button
                android:id="@+id/btn_header_cloud"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_header_diagnostic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_live"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_vod"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_series"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_favs"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_replay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_header_sync"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔄 Synchroniser"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_header_update"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔄 MàJ"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_header_login"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="👤 Compte"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true" />

        </LinearLayout>

        <!-- Dynamic Body Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Split View: Bouquets (left) + Channels / Content (right) -->
            <LinearLayout
                android:id="@+id/layout_content_split"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="0dp">

                <!-- Column 1: Bouquets (Categories) -->
                <LinearLayout
                    android:id="@+id/panel_bouquets"
                    android:layout_width="230dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#0A0F1D"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tv_bouquets_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BOUQUETS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingBottom="6dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_categories"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:descendantFocusability="afterDescendants"
                        android:nextFocusUp="@+id/recycler_categories"
                        android:nextFocusDown="@+id/recycler_categories"
                        android:nextFocusLeft="@+id/sidebar"
                        android:nextFocusRight="@+id/recycler_channels"
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:nestedScrollingEnabled="true" />

                </LinearLayout>

                <!-- Column 2: Channels / Content List (Live Channels or TiviMate VOD Hero + Grid) -->
                <LinearLayout
                    android:id="@+id/panel_channels"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Header for LIVE / REPLAY mode (TiviMate Live EPG Hero Header) -->
                    <LinearLayout
                        android:id="@+id/layout_live_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#0A0F1D"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <!-- Row 1: Channel logo, name, badges, and search input -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_live_hero_logo"
                                android:layout_width="36dp"
                                android:layout_height="24dp"
                                android:scaleType="fitCenter"
                                android:layout_marginEnd="8dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_channels_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CHAÎNES &amp; PROGRAMMES"
                                android:textColor="#38BDF8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_live_hero_res"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HD"
                                android:textColor="#94A3B8"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:paddingStart="5dp"
                                android:paddingEnd="5dp"
                                android:paddingTop="1dp"
                                android:paddingBottom="1dp"
                                android:background="#1E293B"
                                android:layout_marginStart="8dp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_live_hero_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🔴 EN DIRECT"
                                android:textColor="#34D399"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="1dp"
                                android:paddingBottom="1dp"
                                android:background="#132E27"
                                android:layout_marginStart="8dp"
                                android:visibility="gone" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <!-- Quick filter edittext -->
                            <EditText
                                android:id="@+id/et_search"
                                android:layout_width="160dp"
                                android:layout_height="30dp"
                                android:hint="🔍 Filtrer..."
                                android:textColor="#F8FAFC"
                                android:textColorHint="#64748B"
                                android:textSize="11sp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:background="@drawable/bg_item_selector"
                                android:singleLine="true"
                                android:imeOptions="actionSearch"
                                android:focusable="false"
                                android:focusableInTouchMode="false" />

                        </LinearLayout>

                        <!-- Row 2: Selected Program Title & Broadcast Hours -->
                        <LinearLayout
                            android:id="@+id/layout_live_hero_program_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="4dp">

                            <TextView
                                android:id="@+id/tv_live_hero_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Guide des programmes TV"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:maxLines="1"
                                android:ellipsize="end" />

                            <TextView
                                android:id="@+id/tv_live_hero_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="#94A3B8"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginStart="8dp" />

                        </LinearLayout>

                        <!-- Progress Bar (for live running program) -->
                        <ProgressBar
                            android:id="@+id/pb_live_hero_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="2.5dp"
                            android:layout_marginTop="3dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="#38BDF8"
                            android:progressBackgroundTint="#1E293B"
                            android:visibility="gone" />

                        <!-- Row 3: Program Synopsis / Description -->
                        <TextView
                            android:id="@+id/tv_live_hero_desc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Naviguez sur la timeline pour explorer les programmes en direct, passés (Replay) et futurs."
                            android:textColor="#94A3B8"
                            android:textSize="10.5sp"
                            android:maxLines="2"
                            android:ellipsize="end" />

                    </LinearLayout>

                    <!-- TiviMate Hero Header for VOD & SERIES (Hidden in Live, Visible in VOD bouquet grid) -->
                    <LinearLayout
                        android:id="@+id/layout_vod_hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Hero Top Banner (~175dp height) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="175dp"
                            android:background="#080C14">

                            <!-- Movie Backdrop (Right side) -->
                            <ImageView
                                android:id="@+id/iv_vod_hero_backdrop"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:layout_gravity="end"
                                android:contentDescription="Backdrop" />

                            <!-- Gradient Overlay from left to right -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_hero_gradient" />

                            <!-- Left Details Area -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:paddingStart="16dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="6dp"
                                android:paddingEnd="130dp">

                                <!-- Title -->
                                <TextView
                                    android:id="@+id/tv_vod_hero_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Titre du Film"
                                    android:textColor="#FFFFFF"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <!-- Meta row: Quality, Year, Duration, Genre, Rating -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginTop="3dp">

                                    <TextView
                                        android:id="@+id/tv_vod_hero_quality"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="HD"
                                        android:textColor="#38BDF8"
                                        android:textSize="10sp"
                                        android:textStyle="bold"
                                        android:paddingStart="5dp"
                                        android:paddingEnd="5dp"
                                        android:paddingTop="1dp"
                                        android:paddingBottom="1dp"
                                        android:background="@drawable/bg_quality_badge"
                                        android:layout_marginEnd="6dp" />

                                    <TextView
                                        android:id="@+id/tv_vod_hero_year"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="2025"
                                        android:textColor="#E2E8F0"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_vod_hero_duration"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" • 1h 22m"
                                        android:textColor="#E2E8F0"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/tv_vod_hero_genre"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" • Action / Thriller"
                                        android:textColor="#94A3B8"
                                        android:textSize="12sp"
                                        android:maxLines="1"
                                        android:ellipsize="end" />

                                    <TextView
                                        android:id="@+id/tv_vod_hero_rating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" • ⭐ 8.2"
                                        android:textColor="#F59E0B"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                </LinearLayout>

                                <!-- Cast -->
                                <TextView
                                    android:id="@+id/tv_vod_hero_cast"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="Cast: Acteurs"
                                    android:textColor="#CBD5E1"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <!-- Director -->
                                <TextView
                                    android:id="@+id/tv_vod_hero_director"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Director: Réalisateur"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp"
                                    android:maxLines="1"
                                    android:ellipsize="end" />

                                <!-- Plot -->
                                <TextView
                                    android:id="@+id/tv_vod_hero_plot"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="Synopsis du film..."
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp"
                                    android:lineSpacingExtra="2dp"
                                    android:maxLines="3"
                                    android:ellipsize="end" />

                            </LinearLayout>

                            <!-- Top Right Search & Back action buttons -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="10dp"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <Button
                                    android:id="@+id/btn_vod_search"
                                    android:layout_width="36dp"
                                    android:layout_height="32dp"
                                    android:text="🔍"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:background="@drawable/bg_button_selector"
                                    android:focusable="true" />

                                <Button
                                    android:id="@+id/btn_vod_back"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="◄ Bouquets"
                                    android:textColor="#38BDF8"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:background="@drawable/bg_button_selector"
                                    android:layout_marginStart="8dp"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:focusable="true" />

                            </LinearLayout>

                        </FrameLayout>

                        <!-- Mid Bar: Bouquet Name & Position Counter (e.g. 2 / 693) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="#0A0F1D">

                            <TextView
                                android:id="@+id/tv_vod_category_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="MULTI-LANG | TOP 2025 MOVIES"
                                android:textColor="#38BDF8"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/tv_vod_counter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1 / 1"
                                android:textColor="#94A3B8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_channels"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:focusable="false"
                        android:descendantFocusability="afterDescendants"
                        android:nextFocusUp="@+id/recycler_channels"
                        android:nextFocusDown="@+id/recycler_channels"
                        android:nextFocusLeft="@+id/recycler_categories"
                        android:nextFocusRight="@+id/recycler_channels"
                        android:scrollbars="vertical"
                        android:overScrollMode="always"
                        android:nestedScrollingEnabled="true"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:clipToPadding="false" />

                </LinearLayout>

            </LinearLayout>

            <!-- Search Panel (Visible when btn_nav_search is active) -->
            <LinearLayout
                android:id="@+id/panel_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Search Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_global_search"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="🔍 Rechercher chaînes, films, séries, acteurs..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="14sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_item_selector"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="✖ Effacer"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Search Type Filter Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btn_search_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Tout"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_filter_live"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="📺 Direct TV"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_filter_vod"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="🎬 Films VOD"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_filter_series"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="🍿 Séries TV"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_search_results_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Saisissez un texte pour rechercher dans tous les catalogues."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
