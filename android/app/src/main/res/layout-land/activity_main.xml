<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#080C14">

    <!-- 1. LEFT SIDEBAR (v1.3 Navigation Layout) -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#0A0F1D"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Logo / Brand -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KeoTV"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="14dp" />

        <!-- Navigation Buttons -->
        <Button
            android:id="@+id/btn_nav_live"
            android:layout_width="86dp"
            android:layout_height="56dp"
            android:text="📺\nDIRECT"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_nav_replay"
            android:layout_width="86dp"
            android:layout_height="56dp"
            android:text="🔄\nREPLAY"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_nav_vod"
            android:layout_width="86dp"
            android:layout_height="56dp"
            android:text="🎬\nFILMS"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_nav_series"
            android:layout_width="86dp"
            android:layout_height="56dp"
            android:text="🍿\nSÉRIES"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_nav_favs"
            android:layout_width="86dp"
            android:layout_height="56dp"
            android:text="⭐\nFAVORIS"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_nav_search"
            android:layout_width="86dp"
            android:layout_height="56dp"
            android:text="🔍\nCHERCHER"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <!-- Vertical Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Utility Buttons -->
        <Button
            android:id="@+id/btn_nav_settings"
            android:layout_width="86dp"
            android:layout_height="48dp"
            android:text="⚙️\nOPTIONS"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:layout_marginBottom="6dp"
            android:focusable="true" />

        <Button
            android:id="@+id/btn_nav_sync"
            android:layout_width="86dp"
            android:layout_height="48dp"
            android:text="☁️\nSYNCHRO"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            android:background="@drawable/bg_nav_item_selector"
            android:focusable="true" />

    </LinearLayout>

    <!-- 2. MAIN CONTENT AREA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="#0F172A">

            <TextView
                android:id="@+id/tv_section_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 DIRECT TV"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="✅ Prêt"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:background="#132E27" />

            <TextView
                android:id="@+id/tv_header_sync_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:text="Abonnement Xtream"
                android:singleLine="true" />

            <!-- Hidden compatibility buttons for programmatic triggers / portrait -->
            <Button
                android:id="@+id/btn_header_cloud"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_header_diagnostic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_live"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_vod"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_series"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_favs"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/tab_replay"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_header_sync"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔄 Synchroniser"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_header_update"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="🔄 MàJ"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="8dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_header_login"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="👤 Compte"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true" />

        </LinearLayout>

        <!-- Dynamic Body Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Split View: Bouquets (left) + Channels / Content (right) -->
            <LinearLayout
                android:id="@+id/layout_content_split"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Column 1: Bouquets (Categories) -->
                <LinearLayout
                    android:id="@+id/panel_bouquets"
                    android:layout_width="230dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/tv_bouquets_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BOUQUETS"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:paddingBottom="6dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_categories"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:descendantFocusability="afterDescendants"
                        android:scrollbars="vertical" />

                </LinearLayout>

                <!-- Column 2: Channels / Content List (Expanded with TiviMate timeline) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tv_channels_header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CHAÎNES &amp; PROGRAMMES"
                            android:textColor="#64748B"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <!-- Quick filter edittext -->
                        <EditText
                            android:id="@+id/et_search"
                            android:layout_width="180dp"
                            android:layout_height="32dp"
                            android:hint="🔍 Filtrer..."
                            android:textColor="#F8FAFC"
                            android:textColorHint="#64748B"
                            android:textSize="11sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@drawable/bg_item_selector"
                            android:singleLine="true"
                            android:imeOptions="actionSearch"
                            android:focusable="true"
                            android:focusableInTouchMode="false" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_channels"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="false"
                        android:descendantFocusability="afterDescendants"
                        android:scrollbars="vertical" />

                </LinearLayout>

            </LinearLayout>

            <!-- Search Panel (Visible when btn_nav_search is active) -->
            <LinearLayout
                android:id="@+id/panel_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Search Input Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_global_search"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:hint="🔍 Rechercher chaînes, films, séries, acteurs..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#64748B"
                        android:textSize="14sp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/bg_item_selector"
                        android:singleLine="true"
                        android:imeOptions="actionSearch"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_clear"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:text="✖ Effacer"
                        android:textColor="#94A3B8"
                        android:textSize="12sp"
                        android:background="@drawable/bg_button_selector"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:focusable="true" />

                </LinearLayout>

                <!-- Search Type Filter Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btn_search_filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Tout"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_filter_live"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="📺 Direct TV"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_filter_vod"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="🎬 Films VOD"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:layout_marginEnd="6dp"
                        android:focusable="true" />

                    <Button
                        android:id="@+id/btn_search_filter_series"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="🍿 Séries TV"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_tab_selector"
                        android:focusable="true" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_search_results_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Saisissez un texte pour rechercher dans tous les catalogues."
                    android:textColor="#64748B"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_search_results"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants"
                    android:scrollbars="vertical" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
