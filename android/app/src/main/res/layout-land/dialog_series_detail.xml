<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_series_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/bg_card"
    android:padding="18dp">

    <!-- Left Column: Series Metadata, Plot & Actors -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="38"
        android:orientation="vertical"
        android:layout_marginEnd="16dp">

        <!-- Top Row of Left: Cover + Title / Rating / Director -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_series_cover"
                android:layout_width="110dp"
                android:layout_height="160dp"
                android:scaleType="centerCrop"
                android:background="#1E293B"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_series_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Titre de la Série"
                    android:textColor="#F8FAFC"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_series_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ 8.8"
                        android:textColor="#F59E0B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingStart="7dp"
                        android:paddingEnd="7dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:background="#26F59E0B"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tv_series_meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024 • Drame"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_series_director"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp"
                    android:text="Réalisateur : -"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Series Plot / Synopsis -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RÉSUMÉ"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:layout_marginTop="8dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/tv_series_plot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:text="Chargement des informations de la série..." />

        </ScrollView>

        <!-- Individual Actor Chips Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="ACTEURS (cliquez pour voir ses films &amp; séries) :"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- Horizontal Scrollable Actor Chips -->
        <HorizontalScrollView
            android:id="@+id/hsv_series_actors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layout_series_actors_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_series_cast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:text="Chargement des acteurs..." />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Left Column Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_search_series_actor"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔍 Rechercher"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="6dp"
                android:focusable="true" />

            <Button
                android:id="@+id/btn_fav_series"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="⭐ Favori"
                android:textColor="#F8FAFC"
                android:textSize="11sp"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Right Column: Resume Banner, Seasons & Episodes -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="62"
        android:orientation="vertical">

        <!-- Resume Series Banner (Visible if started) -->
        <Button
            android:id="@+id/btn_resume_series"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:text="▶ Reprendre : Épisode 1 (00:00)"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_selector"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="start|center_vertical"
            android:visibility="gone"
            android:focusable="true" />

        <!-- Seasons selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAISONS DISPONIBLES"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingBottom="3dp" />

        <HorizontalScrollView
            android:id="@+id/scroll_seasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/layout_seasons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- Episodes List -->
        <TextView
            android:id="@+id/tv_episodes_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ÉPISODES"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingBottom="3dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_episodes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <!-- Right Bottom Action: Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_close_series"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="✕ Fermer"
                android:textColor="#94A3B8"
                android:textSize="11.5sp"
                android:background="@drawable/bg_button_selector"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
